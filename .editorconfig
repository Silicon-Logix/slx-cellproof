root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,cpp,hpp}]
indent_style = space
indent_size = 4

[*.gd]
indent_style = tab
indent_size = 4

[*.cmd]
end_of_line = crlf
